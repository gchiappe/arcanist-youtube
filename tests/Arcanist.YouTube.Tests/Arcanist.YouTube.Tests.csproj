<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server, run in memory as Arcanist's own tests do (their factory and audio fixtures are shared). -->
    <ProjectReference Include="$(ArcanistRoot)src\Arcanist.Core\Arcanist.Core.csproj" />
    <Compile Include="$(ArcanistRoot)tests\Arcanist.Core.Tests\ArcanistFactory.cs" Link="Shared\ArcanistFactory.cs" />
    <Compile Include="$(ArcanistRoot)tests\Arcanist.Core.Tests\Scanning\AudioFixtures.cs" Link="Shared\AudioFixtures.cs" />
    <!-- Referenced for its pure parts (links, tags); the server loads its own copy, installed as an administrator would. -->
    <ProjectReference Include="..\..\src\Arcanist.YouTube\Arcanist.YouTube.csproj" />
    <ProjectReference Include="..\FakeYtDlp\FakeYtDlp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The extension (as packaged) and the fake yt-dlp, beside the tests. -->
  <Target Name="CopyExtension" AfterTargets="Build">
    <MSBuild Projects="..\..\src\Arcanist.YouTube\Arcanist.YouTube.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="ExtensionAssembly" />
    </MSBuild>
    <MSBuild Projects="..\FakeYtDlp\FakeYtDlp.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="FakeAssembly" />
    </MSBuild>
    <PropertyGroup>
      <FakeFolder>@(FakeAssembly->'%(RootDir)%(Directory)')</FakeFolder>
    </PropertyGroup>
    <ItemGroup>
      <ExtensionFiles Include="@(ExtensionAssembly->'%(RootDir)%(Directory)Arcanist.YouTube.dll');@(ExtensionAssembly->'%(RootDir)%(Directory)arcanist-extension.json')" />
      <ExtensionWeb Include="$(MSBuildThisFileDirectory)..\..\src\Arcanist.YouTube\wwwroot\**" />
      <FakeFiles Include="$(FakeFolder)yt-dlp-fake*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtensionFiles)" DestinationFolder="$(OutDir)extension" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ExtensionWeb)" DestinationFiles="@(ExtensionWeb->'$(OutDir)extension\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FakeFiles)" DestinationFolder="$(OutDir)fake-yt-dlp" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="$(ArcanistRoot)tests\Arcanist.Core.Tests\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
